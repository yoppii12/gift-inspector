# /etc/systemd/system/gift-inspector-api.service
[Unit]
Description=gift-inspector API (Node.js)
After=network-online.target mysql.service
Wants=network-online.target
# 再起動を繰り返して止まったら failed になる。healthcheck.sh が検知して通知する
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=giftinsp
Group=giftinsp
WorkingDirectory=/srv/gift-inspector/api
EnvironmentFile=/etc/gift-inspector/api.env
# 1GB VPS 前提。ヒープを抑え、上限を超えたら OOM で落として systemd に再起動させる
ExecStart=/usr/bin/node --max-old-space-size=256 /srv/gift-inspector/api/server.js
Restart=always
RestartSec=3
MemoryMax=450M
# ログは journald に出る（journalctl -u gift-inspector-api -o cat）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gift-inspector-api

# 権限を絞る
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gift-inspector

[Install]
WantedBy=multi-user.target
