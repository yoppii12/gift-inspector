# ====================================================================
# gift-inspector API の環境変数（キー名のみ。実値はコミットしない）
# VPS では /etc/gift-inspector/api.env（権限 0600）に置き、systemd の
# EnvironmentFile で読み込む。ローカルでは リポジトリ直下の .env に置く。
# ====================================================================

# --- サーバー ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# 起動中のアプリのバージョン（デプロイ時に git のコミットIDを入れる）
APP_VERSION=dev

# --- DB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gift_inspector
DB_PASSWORD=
DB_NAME=gift_inspector

# --- 画像の保存先（公開ディレクトリの外。2027/1末にディレクトリごと削除する） ---
IMAGE_DIR=./var/images
# 受け付ける画像の上限（バイト）。OpenResty の client_max_body_size より小さくする
IMAGE_MAX_BYTES=5242880

# --- AI ---
# 読み取りに使うプロバイダとモデル（社内ベンチ後に確定。docs/plan.md 参照）
# mock はローカル開発・障害注入訓練用
# mock | anthropic | google
AI_PROVIDER=mock
AI_MODEL=
# Claude の推論の深さ（low | medium | high。空ならモデルの既定）
AI_EFFORT=
# キーはプロバイダごと（両方で計測するため）。使うプロバイダの分だけ必須
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# mock のふるまい: ok | schema_invalid | timeout | rate_limited | auth
AI_MOCK_SCENARIO=ok

# --- 判定 ---
# true にすると参考判定（有無・水引）の警告があるとき総合NGにする（D7）
REF_MISMATCH_BLOCKS_OK=false

# --- 開発用の隠しモード（正解の手入力）。デモ環境では必ず false ---
DEV_MODE_ENABLED=false

# --- 通知（空なら通知しない） ---
SLACK_WEBHOOK_URL=
